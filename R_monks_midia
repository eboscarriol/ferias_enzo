# Converte número de coluna em letra:
# 1 = A, 2 = B, 27 = AA etc.
numero_para_coluna <- function(numero) {
  
  resultado <- ""
  
  while (numero > 0) {
    
    resto <- (numero - 1) %% 26
    
    resultado <- paste0(
      LETTERS[resto + 1],
      resultado
    )
    
    numero <- (numero - 1) %/% 26
  }
  
  resultado
}


# Converte datas lidas do Google Sheets
converter_data_sheet <- function(x) {
  
  x <- as.character(x)
  
  resultado <- suppressWarnings(
    as.Date(x)
  )
  
  # Tenta formatos alternativos
  linhas_nao_convertidas <- (
    is.na(resultado) &
      !is.na(x) &
      x != ""
  )
  
  if (any(linhas_nao_convertidas)) {
    
    resultado_alternativo <- suppressWarnings(
      as.Date(
        parse_date_time(
          x[linhas_nao_convertidas],
          orders = c(
            "ymd",
            "dmy",
            "mdy"
          )
        )
      )
    )
    
    resultado[linhas_nao_convertidas] <- resultado_alternativo
  }
  
  # Trata datas armazenadas como número serial
  linhas_numericas <- (
    is.na(resultado) &
      grepl(
        "^[0-9]+(\\.[0-9]+)?$",
        x
      )
  )
  
  if (any(linhas_numericas)) {
    
    resultado[linhas_numericas] <- as.Date(
      as.numeric(x[linhas_numericas]),
      origin = "1899-12-30"
    )
  }
  
  resultado
}


# Valida se as datas estão ordenadas da mais antiga para a mais recente
datas_estao_ordenadas <- function(datas) {
  
  datas_validas <- datas[!is.na(datas)]
  
  if (length(datas_validas) <= 1) {
    return(TRUE)
  }
  
  !is.unsorted(datas_validas)
}


# Lê somente a coluna de data da aba
ler_coluna_data <- function(
    sheet_name,
    coluna_data_numero
) {
  
  coluna_data_letra <- numero_para_coluna(
    coluna_data_numero
  )
  
  resultado <- range_read(
    ss = sheet_id,
    sheet = sheet_name,
    range = paste0(
      coluna_data_letra,
      ":",
      coluna_data_letra
    ),
    col_types = "c"
  )
  
  if (
    ncol(resultado) == 0 ||
    nrow(resultado) == 0
  ) {
    
    return(
      tibble(
        data = as.Date(character()),
        linha_sheet = integer()
      )
    )
  }
  
  tibble(
    data = converter_data_sheet(
      resultado[[1]]
    ),
    
    # A primeira linha retornada é a linha 2,
    # pois a linha 1 contém o cabeçalho
    linha_sheet = seq_len(
      nrow(resultado)
    ) + 1
  )
}


# Verifica se a aba existe e possui dados válidos
aba_tem_dados <- function(
    sheet_name,
    coluna_data_numero
) {
  
  abas_existentes <- sheet_names(
    sheet_id
  )
  
  if (!(sheet_name %in% abas_existentes)) {
    return(FALSE)
  }
  
  datas <- ler_coluna_data(
    sheet_name = sheet_name,
    coluna_data_numero = coluna_data_numero
  )
  
  nrow(datas) > 0 &&
    any(!is.na(datas$data))
}


# Verifica a ordenação da aba
aba_esta_ordenada <- function(
    sheet_name,
    coluna_data_numero
) {
  
  if (
    !aba_tem_dados(
      sheet_name = sheet_name,
      coluna_data_numero = coluna_data_numero
    )
  ) {
    return(TRUE)
  }
  
  datas <- ler_coluna_data(
    sheet_name = sheet_name,
    coluna_data_numero = coluna_data_numero
  )
  
  datas_estao_ordenadas(
    datas$data
  )
}


# Registra a execução na aba de log
registrar_log <- function(
    inicio,
    fim,
    status,
    tipo_atualizacao,
    linhas_loan = NA_integer_,
    linhas_google = NA_integer_,
    mensagem = NA_character_
) {
  
  registro <- tibble(
    inicio_execucao = format(
      inicio,
      "%Y-%m-%d %H:%M:%S"
    ),
    fim_execucao = format(
      fim,
      "%Y-%m-%d %H:%M:%S"
    ),
    duracao_minutos = round(
      as.numeric(
        difftime(
          fim,
          inicio,
          units = "mins"
        )
      ),
      2
    ),
    status = status,
    tipo_atualizacao = tipo_atualizacao,
    linhas_loan = linhas_loan,
    linhas_google = linhas_google,
    mensagem = mensagem
  )
  
  abas_existentes <- sheet_names(
    sheet_id
  )
  
  if (!(sheet_log %in% abas_existentes)) {
    
    sheet_add(
      ss = sheet_id,
      sheet = sheet_log
    )
    
    sheet_write(
      data = registro,
      ss = sheet_id,
      sheet = sheet_log
    )
    
  } else {
    
    sheet_append(
      ss = sheet_id,
      data = registro,
      sheet = sheet_log
    )
  }
}


# Atualiza somente os últimos 60 dias
atualizar_aba_incremental <- function(
    dados_novos,
    sheet_name,
    coluna_data,
    data_inicio_atualizacao
) {
  
  # Garante que os dados novos estejam ordenados
  dados_novos <- dados_novos %>%
    arrange(
      .data[[coluna_data]]
    )
  
  coluna_data_numero <- match(
    coluna_data,
    names(dados_novos)
  )
  
  if (is.na(coluna_data_numero)) {
    
    stop(
      paste0(
        "A coluna de data '",
        coluna_data,
        "' não foi encontrada nos dados."
      )
    )
  }
  
  ultima_coluna <- numero_para_coluna(
    ncol(dados_novos)
  )
  
  # Lê a coluna de data atual
  datas_atuais <- ler_coluna_data(
    sheet_name = sheet_name,
    coluna_data_numero = coluna_data_numero
  )
  
  # Interrompe se a base não estiver ordenada
  if (
    !datas_estao_ordenadas(
      datas_atuais$data
    )
  ) {
    
    stop(
      paste0(
        "A aba '",
        sheet_name,
        "' não está ordenada da data mais antiga ",
        "para a mais recente."
      )
    )
  }
  
  # Localiza a primeira linha dos últimos 60 dias
  linhas_recentes <- datas_atuais %>%
    filter(
      !is.na(data),
      data >= data_inicio_atualizacao
    )
  
  if (nrow(linhas_recentes) > 0) {
    
    primeira_linha_atualizacao <- min(
      linhas_recentes$linha_sheet
    )
    
  } else {
    
    # Caso não existam dados do período,
    # escreve depois da última linha existente
    primeira_linha_atualizacao <- nrow(
      datas_atuais
    ) + 2
  }
  
  message(
    sheet_name,
    ": limpando dados a partir da linha ",
    primeira_linha_atualizacao,
    "."
  )
  
  # Limpa todo o trecho a partir da primeira data recente.
  # Como a aba está ordenada, esse trecho corresponde
  # aos últimos 60 dias até o final da base.
  range_clear(
    ss = sheet_id,
    sheet = sheet_name,
    range = paste0(
      "A",
      primeira_linha_atualizacao,
      ":",
      ultima_coluna
    )
  )
  
  # Escreve novamente somente os últimos 60 dias
  if (nrow(dados_novos) > 0) {
    
    message(
      sheet_name,
      ": escrevendo ",
      format(
        nrow(dados_novos),
        big.mark = "."
      ),
      " linhas."
    )
    
    range_write(
      ss = sheet_id,
      data = dados_novos,
      sheet = sheet_name,
      range = paste0(
        "A",
        primeira_linha_atualizacao
      ),
      col_names = FALSE
    )
  }
  
  # Validação final da ordenação
  datas_finais <- ler_coluna_data(
    sheet_name = sheet_name,
    coluna_data_numero = coluna_data_numero
  )
  
  if (
    !datas_estao_ordenadas(
      datas_finais$data
    )
  ) {
    
    stop(
      paste0(
        "A aba '",
        sheet_name,
        "' não ficou ordenada após a atualização."
      )
    )
  }
  
  message(
    sheet_name,
    ": atualização concluída e ordenação validada."
  )
}


