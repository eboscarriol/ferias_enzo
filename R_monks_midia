      mensagem = mensagem_execucao
    )
    
  }, error = function(e) {
    
    message(
      "Não foi possível registrar o log: ",
      conditionMessage(e)
    )
  })
  
  
  # ---------------------------------------------------------------------------
  # 11. ENCERRAR CONEXÃO
  # ---------------------------------------------------------------------------
  
  if (
    !is.null(con) &&
    DBI::dbIsValid(con)
  ) {
    
    dbDisconnect(
      con
    )
  }
  
  message(
    "Execução finalizada com status: ",
    status_execucao
  )
})
